{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pbc-media-publisher",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    "BUZZSPROUT_PODCAST_ID": "1986438"
  },
  "routes": [
    {
      "pattern": "sermon-publisher.pbctulsa.org",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
